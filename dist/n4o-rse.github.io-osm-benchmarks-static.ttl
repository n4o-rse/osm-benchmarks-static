# RDFS bridge of the kernel (wikibase-static): the direct properties P1 to P3 and the classes Q1 to Q3 tied to RDFS and OWL.
# Not part of the Wikibase data model; written only when the kernel is part of the site.

obs:Q1
    owl:equivalentClass rdfs:Class .

obs:Q2
    owl:equivalentClass rdf:Property .

obs:Q3
    owl:equivalentClass owl:Thing .

obst:P1
    rdfs:subPropertyOf rdfs:subClassOf .

obst:P2
    rdfs:subPropertyOf rdf:type .

obst:P3
    rdfs:subPropertyOf rdfs:subPropertyOf .

# CIDOC CRM anchoring (wikibase-static): the classes of this site tied to classes of the CIDOC CRM and its extensions (data/crm.csv) and the DCAT classes of this file (data/dcat-crm.csv),
# with the superclasses of an extension class up to its first class of the CIDOC CRM, and subclass of / instance of spelled out as rdfs:subClassOf / rdf:type. Not part of the Wikibase data model.

obs:Q100
    rdfs:subClassOf crm:E25_Human-Made_Feature .

