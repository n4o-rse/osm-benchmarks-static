PREFIX obsp: <https://n4o-rse.github.io/osm-benchmarks-static/prop/>
PREFIX obspq: <https://n4o-rse.github.io/osm-benchmarks-static/prop/qualifier/>
PREFIX obsps: <https://n4o-rse.github.io/osm-benchmarks-static/prop/statement/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

#defaultView:Map
SELECT ?item ?label ?geometry ?since WHERE {
  ?item obsp:P111 ?entry ;
        rdfs:label ?label .
  ?entry obsps:P111 ?geometry ;
         obspq:P103 ?since .
  FILTER(LANG(?label) = "en")
  FILTER(?since <= "2023-01-01T00:00:00Z")
  FILTER NOT EXISTS {
    ?item obsp:P111 ?later .
    ?later obspq:P103 ?laterSince .
    FILTER(?laterSince > ?since && ?laterSince <= "2023-01-01T00:00:00Z")
  }
}
ORDER BY ?label ?item
LIMIT 200
