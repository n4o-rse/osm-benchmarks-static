PREFIX obsp: <https://n4o-rse.github.io/osm-benchmarks-static/prop/>
PREFIX obspq: <https://n4o-rse.github.io/osm-benchmarks-static/prop/qualifier/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?item ?label (COUNT(?statement) AS ?versions) (MIN(?timestamp) AS ?first) (MAX(?timestamp) AS ?last) WHERE {
  ?item obsp:P101 ?statement ;
        rdfs:label ?label .
  ?statement obspq:P103 ?timestamp .
  FILTER(LANG(?label) = "en")
}
GROUP BY ?item ?label
ORDER BY DESC(?versions) ?label ?item
LIMIT 100
